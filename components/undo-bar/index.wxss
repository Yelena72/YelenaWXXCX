/* components/undo-bar/index.wxss —— 删除后的撤销条 */

.undo-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 140rpx;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #2C3E66;
  border: 4rpx solid #1B2A4A;
  box-shadow: 8rpx 8rpx 0 rgba(44, 62, 102, 0.25);
  box-sizing: border-box;
  animation: undoIn 0.24s ease-out;
}

.undo-text {
  flex: 1;
  font-size: 26rpx;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.undo-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  color: #2C3E66;
  background-image: linear-gradient(180deg, #FFE58A 0%, #FFB93C 100%);
  border: 3rpx solid #FFE58A;
  box-sizing: border-box;
}

.undo-btn-hover {
  background-image: linear-gradient(180deg, #FFF1BC 0%, #FFC95C 100%);
}

@keyframes undoIn {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
