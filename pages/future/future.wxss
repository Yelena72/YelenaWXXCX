/* pages/future/future.wxss —— 未来展望 */

@import "../../styles/scenes.wxss";

/* ---------------- 顶部说明 ---------------- */
.head {
  display: flex;
  align-items: center;
}

.head-ico {
  width: 84rpx;
  height: 84rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.head-title {
  font-size: 34rpx;
  color: #2C3E66;
  letter-spacing: 2rpx;
}

.head-sub {
  font-size: 24rpx;
  color: #6B7EA8;
  margin-top: 6rpx;
}

/* ---------------- 分组标题 ---------------- */
.section-head {
  display: flex;
  align-items: center;
  margin: 10rpx 0 20rpx;
}

.section-bar {
  width: 12rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border: 3rpx solid #2C3E66;
  box-sizing: border-box;
}

.section-name {
  font-size: 32rpx;
  color: #2C3E66;
  letter-spacing: 2rpx;
  margin-right: 14rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #7A8FB5;
}

/* ---------------- 统一的展望卡 ---------------- */
.wish {
  padding: 0;
  overflow: hidden;
}

.wish-media {
  position: relative;
  width: 100%;
  height: 341rpx;
}

.wish-art {
  width: 100%;
  height: 100%;
}

.wish-img {
  display: block;
  width: 100%;
  height: 100%;
}

.wish-no {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  width: 46rpx;
  height: 46rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #2C3E66;
  background: #FFFFFF;
  border: 3rpx solid #2C3E66;
  box-shadow: 3rpx 3rpx 0 rgba(44, 62, 102, 0.22);
  box-sizing: border-box;
}

.wish-body {
  padding: 26rpx 28rpx 30rpx;
}

.wish-text {
  font-size: 30rpx;
  color: #2C3E66;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.wish-note {
  font-size: 24rpx;
  color: #6B7EA8;
  line-height: 1.7;
  margin-top: 10rpx;
}

.wish-when {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2C3E66;
  padding: 3rpx 16rpx 2rpx;
  background-image: linear-gradient(180deg, #FFE58A 0%, #FFB93C 100%);
  border: 3rpx solid #2C3E66;
  box-shadow: 3rpx 3rpx 0 rgba(44, 62, 102, 0.18);
}

/* ---------------- 添加按钮 ---------------- */
.add-wish {
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5B6B95;
  background: rgba(255, 255, 255, 0.55);
  border: 4rpx dashed #9AB0D0;
  margin-bottom: 40rpx;
}

.add-wish-hover {
  background: rgba(255, 255, 255, 0.9);
}

/* ---------------- 弹出表单 ---------------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 30, 50, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #FFF6E5;
  border-top: 6rpx solid #2C3E66;
  box-sizing: border-box;
  padding: 26rpx 28rpx 40rpx;
  animation: sheetUp 0.22s ease-out;
}

@keyframes sheetUp {
  from { transform: translateY(50rpx); opacity: 0; }
  to   { transform: translateY(0); opacity: 1; }
}

.sheet-title {
  font-size: 32rpx;
  color: #2C3E66;
  text-align: center;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.sheet-body {
  max-height: 58vh;
  overflow-y: auto;
}

.field-label {
  font-size: 24rpx;
  color: #6B7EA8;
  margin: 18rpx 0 10rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 24rpx;
  color: #2C3E66;
  padding: 10rpx 24rpx;
  margin: 0 12rpx 10rpx 0;
  background: #FFFFFF;
  border: 4rpx solid #C9DDF0;
}

.chip.on {
  border-color: #2C3E66;
  background-image: linear-gradient(180deg, #FFE58A 0%, #FFB93C 100%);
  box-shadow: 3rpx 3rpx 0 rgba(44, 62, 102, 0.18);
}

.field {
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-family: "PixelCN", monospace;
  color: #2C3E66;
  background: #FFFFFF;
  border: 4rpx solid #2C3E66;
}

.ph {
  color: #9AB0D0;
}

/* 配图选择 */
.scenes {
  display: flex;
  justify-content: space-between;
}

.scene-chip {
  width: 18.5%;
}

.scene-thumb {
  width: 100%;
  height: 62rpx;
  border: 3rpx solid #C9DDF0;
  box-sizing: border-box;
}

.scene-chip.on .scene-thumb {
  border-color: #2C3E66;
  box-shadow: 0 0 0 3rpx #FFB93C;
}

.scene-name {
  font-size: 24rpx;
  color: #5B6B95;
  text-align: center;
  margin-top: 6rpx;
}

/* 上传 */
.upload-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.upload-btn {
  font-size: 24rpx;
  color: #2C3E66;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border: 4rpx solid #2C3E66;
  box-shadow: 4rpx 4rpx 0 rgba(44, 62, 102, 0.18);
}

.upload-btn-hover {
  transform: translate(4rpx, 4rpx);
  box-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.upload-preview {
  position: relative;
  margin-left: 18rpx;
  width: 120rpx;
  height: 80rpx;
}

.upload-img {
  display: block;
  width: 100%;
  height: 100%;
  border: 3rpx solid #2C3E66;
  box-sizing: border-box;
}

.upload-clear {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #FFFFFF;
  background: #FF7A6B;
  border: 3rpx solid #2C3E66;
  box-sizing: border-box;
}

/* 底部按钮 */
.sheet-actions {
  display: flex;
  margin-top: 26rpx;
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2C3E66;
  background: #FFFFFF;
  border: 5rpx solid #2C3E66;
  margin-right: 16rpx;
  box-sizing: border-box;
}

.btn-ghost-hover {
  background: #E8F4FF;
}

.btn-main {
  flex: 2;
  height: 88rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
  background-image: linear-gradient(180deg, #9FE87A 0%, #45C25F 100%);
  border: 5rpx solid #2C3E66;
  box-shadow: 5rpx 5rpx 0 rgba(44, 62, 102, 0.18);
  box-sizing: border-box;
}

.btn-main-hover {
  transform: translate(5rpx, 5rpx);
  box-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* 相册按钮下面的小提示 */
.upload-tip {
  font-size: 24rpx;
  color: #9AB0D0;
  line-height: 1.6;
  margin-top: 12rpx;
}

/* 卡片操作提示 */
.wish-tip {
  text-align: center;
  font-size: 24rpx;
  color: #9AB0D0;
  letter-spacing: 1rpx;
  margin: -10rpx 0 30rpx;
}

/* 正在修改的那张卡片：描边换成提示色 */
.wish-editing {
  border-color: #3E8FD0;
  box-shadow:
    inset 0 5rpx 0 rgba(255, 255, 255, 0.95),
    12rpx 12rpx 0 rgba(62, 143, 208, 0.28),
    0 20rpx 36rpx rgba(62, 143, 208, 0.18);
}

/* 表单里的删除按钮 */
.btn-del {
  color: #C93A3A;
  background: #FFF3F1;
  border-color: #E5544B;
}

.btn-del-hover {
  background: #FFE2DD;
}
