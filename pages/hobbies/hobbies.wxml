<!-- pages/hobbies/hobbies.wxml —— 兴趣爱好 -->

<!-- 拖动卡片排序时要锁住页面滚动，所以整个页面放在 scroll-view 里 -->
<scroll-view
  class="page-scroll"
  scroll-y="{{!dragging}}"
  scroll-with-animation
  scroll-into-view="{{scrollTo}}"
>
  <view class="page-wrap">

    <view class="tip-line">点卡片修改，长按卡片可以拖动排序</view>

    <!-- 兴趣卡片 -->
    <view class="grid">
      <view
        class="card {{dragIndex === index ? 'drag-on' : ''}}"
        wx:for="{{list}}"
        wx:key="id"
        wx:for-index="index"
        hover-class="px-card-hover"
        style="{{dragging ? 'transform: translate3d(' + item.tx + 'px, ' + item.ty + 'px, 0);' : ''}}"
        data-id="{{item.id}}"
        bindtap="edit"
        bindlongpress="onDragStart"
        bindtouchmove="onDragMove"
        bindtouchend="onDragEnd"
        bindtouchcancel="onDragEnd"
      >
        <view class="card-ico ico {{item.icon}}"></view>
        <view class="name">{{item.name}}</view>
        <view wx:if="{{item.desc}}" class="desc">{{item.desc}}</view>
      </view>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty">还没有兴趣，在下面加一个吧</view>

    <!-- 添加 / 修改 -->
    <view class="px-card" id="hobby-form">
      <view class="px-title">{{editingId ? '修改兴趣' : '添加兴趣'}}</view>

      <view class="icons">
        <view
          class="icon-chip {{formIcon === ic ? 'on' : ''}}"
          wx:for="{{iconList}}"
          wx:for-item="ic"
          wx:key="*this"
          data-icon="{{ic}}"
          bindtap="pickIcon"
        >
          <view class="ico {{ic}} icon-preview"></view>
        </view>
      </view>

      <input
        class="field"
        placeholder="兴趣名称，比如：摄影"
        placeholder-class="ph"
        value="{{formName}}"
        bindinput="onName"
        bindblur="onBlur"
        focus="{{focusField === 'name'}}"
        maxlength="10"
        cursor-spacing="24"
      />

      <input
        class="field"
        placeholder="一句话描述（可以不填）"
        placeholder-class="ph"
        value="{{formDesc}}"
        bindinput="onDesc"
        maxlength="20"
      />

      <view class="form-actions">
        <view class="px-btn form-btn" hover-class="px-btn-hover" bindtap="save">保存</view>
        <view
          wx:if="{{editingId}}"
          class="px-btn form-btn form-btn-del"
          hover-class="px-btn-hover"
          bindtap="remove"
        >删除</view>
      </view>
    </view>

  </view>
</scroll-view>

<undo-bar show="{{undoShow}}" seq="{{undoSeq}}" text="{{undoText}}" bind:undo="onUndo" bind:close="onUndoClose" />

<!-- ================= 修改兴趣：屏幕中间的弹窗 ================= -->
<view wx:if="{{editShow}}" class="pop-mask" style="padding-bottom: {{kbH}}px;" bindtap="closeEdit">
  <view class="pop-dialog" catchtap="noop">
    <view class="px-title">修改兴趣</view>

    <view class="icons">
      <view
        class="icon-chip {{formIcon === ic ? 'on' : ''}}"
        wx:for="{{iconList}}"
        wx:for-item="ic"
        wx:key="*this"
        data-icon="{{ic}}"
        bindtap="pickIcon"
      >
        <view class="ico {{ic}} icon-preview"></view>
      </view>
    </view>

    <input
      class="field"
      placeholder="兴趣名称，比如：摄影"
      placeholder-class="ph"
      value="{{formName}}"
      bindinput="onName"
      maxlength="10"
      cursor-spacing="24"
      adjust-position="{{false}}"
    />

    <input
      class="field"
      placeholder="一句话描述（可以不填）"
      placeholder-class="ph"
      value="{{formDesc}}"
      bindinput="onDesc"
      maxlength="20"
      cursor-spacing="24"
      adjust-position="{{false}}"
    />

    <view class="form-actions">
      <view class="px-btn form-btn" hover-class="px-btn-hover" bindtap="save">保存</view>
      <view class="px-btn form-btn form-btn-ghost" hover-class="px-btn-hover" bindtap="closeEdit">取消</view>
      <view class="px-btn form-btn form-btn-del" hover-class="px-btn-hover" bindtap="remove">删除</view>
    </view>
  </view>
</view>
