/* pages/todo/todo.wxss —— 待办事项 */

/* 让页面撑满一屏，好把草地页脚推到底部 */
.page-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 36rpx;
  box-sizing: border-box;
}

/* ---------------- 进度卡 ---------------- */
.stat-card {
  background-image: linear-gradient(180deg, #EAF9FF 0%, #FFFFFF 62%);
}

.stat-top {
  display: flex;
  align-items: center;
}

.stat-ico {
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.stat-mid {
  flex: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #6B7EA8;
  letter-spacing: 2rpx;
}

.stat-nums {
  margin-top: 4rpx;
}

.n-done {
  font-size: 56rpx;
  color: #2C3E66;
}

.n-total {
  font-size: 26rpx;
  color: #9AB0D0;
  margin-left: 4rpx;
}

.stat-pct {
  font-size: 34rpx;
  color: #45C25F;
}

/* 进度条 */
.stat-bar {
  height: 24rpx;
  background: #E8F4FF;
  border: 4rpx solid #2C3E66;
  margin: 22rpx 0 14rpx;
  box-sizing: border-box;
}

.stat-fill {
  height: 100%;
  background-image:
    repeating-linear-gradient(
      90deg,
      rgba(44, 62, 102, 0.22) 0 4rpx,
      transparent 4rpx 14rpx
    ),
    linear-gradient(180deg, #9FE87A 0%, #45C25F 100%);
  transform-origin: left center;
  animation: pxGrow 0.8s cubic-bezier(0.2, 0.8, 0.3, 1) backwards;
}

.stat-note {
  font-size: 24rpx;
  color: #6B7EA8;
}

/* ---------------- 输入区 ---------------- */

/* 添加卡：淡蓝到淡绿的渐变 + 细点阵，不再是纯白 */
.add-card {
  background-image:
    radial-gradient(circle, rgba(44, 62, 102, 0.07) 1.5rpx, transparent 2rpx),
    linear-gradient(160deg, #E9F8FF 0%, #F9FDFF 52%, #EFFBF1 100%);
  background-size: 18rpx 18rpx, auto;
}

.add-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.add-head .px-title {
  margin-bottom: 0;
}

.add-plus {
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.add-card .input {
  background: #FFFFFF;
  box-shadow: inset 0 6rpx 0 rgba(44, 62, 102, 0.06);
}

.add-hint {
  font-size: 24rpx;
  color: #6E90A8;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

.input-row {
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  font-size: 28rpx;
  font-family: "PixelCN", monospace;
  background: #F4FBFF;
  border: 5rpx solid #2C3E66;
}

.ph {
  color: #9AB0D0;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 88rpx;
  margin-left: 16rpx;
  background-image: linear-gradient(180deg, #9FE87A 0%, #45C25F 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  border: 5rpx solid #2C3E66;
  box-shadow: 6rpx 6rpx 0 rgba(44, 62, 102, 0.18);
  flex-shrink: 0;
}

.add-btn-hover {
  transform: translate(6rpx, 6rpx);
  box-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* ---------------- 分组标题 ---------------- */
.group-head {
  display: flex;
  align-items: center;
  margin: 6rpx 0 18rpx;
}

.group-name {
  font-size: 24rpx;
  color: #5B6B95;
  letter-spacing: 2rpx;
}

.group-count {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #2C3E66;
  background: #FFE58A;
  border: 3rpx solid #2C3E66;
  padding: 2rpx 12rpx;
}

.group-count-done {
  background: #9FE87A;
}

/* ---------------- 单条待办 ---------------- */
.todo {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  background-image: linear-gradient(180deg, #FFFFFF 0%, #ECF8FF 100%);
  border: 6rpx solid #2C3E66;
  box-shadow:
    9rpx 9rpx 0 rgba(44, 62, 102, 0.14),
    0 14rpx 26rpx rgba(44, 62, 102, 0.10);
  padding: 24rpx 22rpx;
  margin-bottom: 26rpx;
  transition: transform 0.14s ease, box-shadow 0.14s ease;
  animation: pxRise 0.34s ease-out backwards;
}

/* 按一下：整条往上飘一点 */
.todo-hover {
  transform: translateY(-8rpx);
  background-image: linear-gradient(180deg, #FFFFFF 0%, #E0F3FF 100%);
  box-shadow:
    11rpx 14rpx 0 rgba(44, 62, 102, 0.12),
    0 24rpx 34rpx rgba(44, 62, 102, 0.16);
}

/* 已完成的条目：换成淡绿底 */
.todo-done {
  background-image: linear-gradient(180deg, #FFFFFF 0%, #EEFBEC 100%);
}

.todo-hover {
  background-image: linear-gradient(180deg, #FFFFFF 0%, #E4F5FF 100%);
}

/* 勾选框 */
.box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  font-size: 30rpx;
  background: #FFFFFF;
  border: 5rpx solid #2C3E66;
  box-sizing: border-box;
  flex-shrink: 0;
}

.box-on {
  background-image: linear-gradient(180deg, #9FE87A 0%, #45C25F 100%);
  color: #FFFFFF;
  animation: pxPopSmall 0.32s ease-out;
}

@keyframes pxPopSmall {
  0%   { transform: scale(0.5); }
  60%  { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.todo-text {
  flex: 1;
  margin: 0 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.done {
  color: #9AB0D0;
  text-decoration: line-through;
}

.del {
  font-size: 30rpx;
  color: #FF7A6B;
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* 「改」按钮：和删除并排，但颜色柔和一点 */
.edit {
  font-size: 24rpx;
  color: #3E8FD0;
  padding: 2rpx 10rpx;
  margin-right: 6rpx;
  border: 3rpx solid #B8DCF5;
  background: #F2FAFF;
  flex-shrink: 0;
}

/* 正在修改的那一条：描边加个提示色 */
.todo-editing {
  border-color: #3E8FD0;
  box-shadow:
    9rpx 9rpx 0 rgba(62, 143, 208, 0.28),
    0 14rpx 26rpx rgba(44, 62, 102, 0.10);
}

/* 修改状态下的输入卡：换个底色，一眼能看出在编辑 */
.add-card-editing {
  background-image:
    radial-gradient(circle, rgba(44, 62, 102, 0.07) 1.5rpx, transparent 2rpx),
    linear-gradient(160deg, #FFF7E8 0%, #FFFDF8 55%, #EFF8FF 100%);
}

.cancel-row {
  margin-top: 16rpx;
  text-align: right;
}

.cancel {
  display: inline-block;
  font-size: 24rpx;
  color: #7A8FB5;
  padding: 8rpx 18rpx;
  border: 3rpx solid #CBDDF0;
  background: #FFFFFF;
}

.cancel-hover {
  background: #F0F7FF;
}

/* ---------------- 空状态 ---------------- */
.empty {
  text-align: center;
  padding: 70rpx 0 40rpx;
}

.empty-ico {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #2C3E66;
}

.empty-sub {
  font-size: 24rpx;
  color: #7A8FB5;
  margin-top: 10rpx;
}

/* ---------------- 底部草地 ---------------- */
.page-foot {
  margin-top: auto;
  margin-left: -28rpx;
  margin-right: -28rpx;
  padding-top: 40rpx;
}

.end-note {
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #4F8A4A;
  padding: 14rpx 0 0;
}

/* 列表上方的操作提示 */
.list-hint {
  text-align: center;
  font-size: 24rpx;
  color: #9AB0D0;
  letter-spacing: 1rpx;
  margin: -26rpx 0 28rpx;
}
